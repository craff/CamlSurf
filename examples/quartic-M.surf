
let pi = acos(-1);
let tetra_angle = pi - (109.47122063449069174*pi/180);
let cz = cos(tetra_angle);
let cy = sin(tetra_angle);

let pt1(x,y,z) = z - 1;
let pt2(x,y,z) = -1*cy*y + cz*z + 1;
let pt3(x,y,z) = sin(2*pi/3)*cy*x -cos(2*pi/3)*cy*y + cz*z + 1;
let pt4(x,y,z) = sin(4*pi/3)*cy*x -cos(4*pi/3)*cy*y + cz*z + 1;

{ surface pt1 : pt1(3*x,3*y,3*z) bound (3*x)^2+(3*y)^2+(3*z)^2 - 8^2;
  surface pt2 : pt2(3*x,3*y,3*z) bound (3*x)^2+(3*y)^2+(3*z)^2 - 8^2;
  surface pt3 : pt3(3*x,3*y,3*z) bound (3*x)^2+(3*y)^2+(3*z)^2 - 8^2;
  surface pt4 : pt4(3*x,3*y,3*z) bound (3*x)^2+(3*y)^2+(3*z)^2 - 8^2;
}

sleep 5;

let q0(x,y,z) =  pt1(x,y,z)*pt2(x,y,z)*pt3(x,y,z)*pt4(x,y,z);

let r1 = 7;
let s1(x,y,z) = x^2 + y^2 + z^2 - r1^2;
let r2 = 4;
let s2(x,y,z) = x^2 + y^2 + z^2 - r2^2;

{ color = (0.5, 0.5, 0.9, 0.3) ;
  back_color = none;
  surface s1 : s1(3*x,3*y,3*z);
  surface s2 : s2(3*x,3*y,3*z);
}

sleep 5;

let ra = 0;
let a = 0.001;

let q(x,y,z) = q0(x,y,z) + a*s1(x,y,z)*s2(x,y,z) + ra;

{ color = (0.7, 0.7, 0.4, 1.0) ;
  surface q : q(3*x,3*y,3*z) bound (3*x)^2+(3*y)^2+(3*z)^2 - 8^2;
}
remove pt1;
remove pt2;
remove pt3;
remove pt4;

sleep 5;
remove s1;
remove s2;
