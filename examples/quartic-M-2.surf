precision = 1;

# Equation of the 4 faces of a tetraedron.


let pi = acos(-1);
let tetra_angle = pi - (109.47122063449069174*pi/180);
let cz = cos(tetra_angle);
let cy = sin(tetra_angle);

let pt1(x,y,z) = z - 1;
let pt2(x,y,z) = -1*cy*y + cz*z + 1;
let pt3(x,y,z) = sin(2*pi/3)*cy*x -cos(2*pi/3)*cy*y + cz*z + 1;
let pt4(x,y,z) = sin(4*pi/3)*cy*x -cos(4*pi/3)*cy*y + cz*z + 1;

let sb = x^2 + y^2 + z^2 - 7;
{
  color = (0.7, 0.7, 0.2);

  surface p1 : pt1(x,y,z) bound sb;
  surface p2 : pt2(x,y,z) bound sb;
  surface p3 : pt3(x,y,z) bound sb;
  surface p4 : pt4(x,y,z) bound sb;
}

sleep 5;

let q0(x,y,z) =  pt1(x,y,z)*pt2(x,y,z)*pt3(x,y,z)*pt4(x,y,z);

let r1 = 2;
let s1(x,y,z) = x^2 + y^2 + z^2 - r1^2;

# Ajout d'un sphere du bon rayon
{
  shininess = 50;
  specular = .7;
  color = (0.5, 0.5, 0.9, 0.33);
  precision = 1e-1;
  mindivs = 0;
  surface s1 : s1(x,y,z);
}

sleep 5;

# the intersection of the planes and the sphere
{
  line_color = (1.0, 1.0, 1.0);
  curve i1 : pt1(x,y,z) on s1;
  curve i2 : pt2(x,y,z) on s1;
  curve i3 : pt3(x,y,z) on s1;
  curve i4 : pt4(x,y,z) on s1;
}

remove p1;
remove p2;
remove p3;
remove p4;

sleep 5;

# final quartic with 10 compact components
let ra = 0.05;
let a = 0.5;
let q1(x,y,z) = q0(x,y,z) + a*s1(x,y,z)^2 + ra;
{
  color = (0.6, 0.6, 0.2);
  mindivs = 0;
  precision = 1e-2;
  surface q1 : q1(x,y,z);
}
