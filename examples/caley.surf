# Cayley's cubic with variable parameter

let k = 3 *  min(1.3*cos(time/11) + 0.3, 1);
let a = 1;

let p = (x+y+z-a)*(x*y + y*z + z*x) - k*x*y*z;

surface cayley : p bound x^2+y^2+z^2-5;

# the nine lines on the surface
# Les côtés du tétraèdre en bleu
line_color = (0.2,0.2,1.0);
curve l1 : x^2 + y^2 on cayley;
curve l2 : y^2 + z^2 on cayley;
curve l3 : z^2 + x^2 on cayley;
curve l4 : (x+y-1)^2 + z^2 on cayley;
curve l5 : (y+z-1)^2 + x^2 on cayley;
curve l6 : (z+x-1)^2 + y^2 on cayley;

# Les 3 autres droites en vert
line_color = (0.2,1,0.2);
curve l7 : (x+y)^2 + ((1-k)*z - 1)^2 on cayley;
curve l8 : (y+z)^2 + ((1-k)*x - 1)^2 on cayley;
curve l9 : (z+x)^2 + ((1-k)*y - 1)^2 on cayley;
