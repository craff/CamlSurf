# Cayley's cubic with variable parameter

let k = 3 *  cos(time/11);
let a = 1;

let p = (x+y+z-a)*(x*y + y*z + z*x) - k*x*y*z;

surface cayley : p bound x^2+y^2+z^2-5;

# the nine lines on the surface
# Les côtés du tétraèdre en bleu
line_color = (0.2,0.2,1.0);
curve l1 : x on cayley;
curve l2 : y on cayley;
curve l3 : z on cayley;
curve l456 : x+y+z-1 on cayley;

# Les 3 autres droites en vert
line_color = (0.2,1,0.2);
curve l789 : x+y+z-1/(1-k) on cayley;

time_factor = 0;
time = 0;
sleep 15;
time_factor = 1;