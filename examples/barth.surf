# barth sextic with variable parameter

let phi = (1+sqrt(5)) / 2 ;
let t = min(1.3*cos(time/11) + 0.3, 1) * phi ;
let a = min(1.3*cos(time/13) + 0.3, 1) * (1+2*phi);

mindivs = 0;         # do not need a priori subdivision
precision = 1e-2;    # more precision for the cubic interpolation, for sharper
                     # singularities

let p =
  4 * (t^2*x^2-y^2)*(t^2*y^2-z^2)*(t^2*z^2-x^2)
  - a*(x^2+y^2+z^2-1)^2 ;

surface barth : p bound x^2+y^2+z^2-5;
